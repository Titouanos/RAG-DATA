# Copier en .env pour `docker compose up`. Ne pas committer .env.

# --- Provider LLM (défaut cible : Mistral, hébergé en EU) ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
MISTRAL_API_KEY=changeme
# Option qualité : ANTHROPIC_API_KEY=... (LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5)
# Option Gemini : GEMINI_API_KEY=...   (LLM_PROVIDER=gemini)

# --- Premier administrateur (créé au démarrage, idempotent) ---
RAGB_ADMIN_USER=admin
RAGB_ADMIN_PASSWORD=changeme

# --- Reverse proxy / TLS ---
CADDY_DOMAIN=rag.interne.exemple.fr      # domaine interne servi par Caddy
PUBLIC_URL=https://rag.interne.exemple.fr # origine CORS autorisée

# --- Divers (facultatif) ---
# MAX_UPLOAD_MB=100
# OCR_LANGUAGES=fra+eng
