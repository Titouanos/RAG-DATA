# --- Copie ce fichier en .env et renseigne les valeurs. .env n'est jamais commité. ---

# =========================
#  Stockage
# =========================
# STORAGE_DIR=storage
# DATA_DIR=data

# =========================
#  Qdrant
# =========================
QDRANT_MODE=local                 # local (embarqué) | server (Docker)
# QDRANT_URL=http://localhost:6333 # mode server
# QDRANT_API_KEY=

# =========================
#  Embeddings (figés par collection à la création)
# =========================
EMBEDDER=local_bge_m3             # local_bge_m3 (défaut, 100% local) | gemini
# DENSE_MODEL=BAAI/bge-m3
# MODELS_CACHE_DIR=storage/models_cache
# HF_OFFLINE=false                # true en prod (réseau filtré : aucun téléchargement HF au runtime)

# =========================
#  Reranking (désactivé par défaut : trop lent sur CPU, cf. CLAUDE.md)
# =========================
RERANK_ENABLED=false
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# =========================
#  Retrieval
# =========================
# TOP_K=5
# RERANK_K=20
# RRF_K=60

# =========================
#  Génération (LLM)
# =========================
LLM_PROVIDER=gemini              # gemini (Phase 1) | mistral | anthropic | ollama (Phase 4)
LLM_MODEL=gemini-2.5-flash
# Clé Gemini (réutilisée en Phase 1 pour la génération et la vision optionnelle) :
GEMINI_API_KEY=your_api_key_here
# Défaut cible (Phase 4) : Mistral, hébergé en EU
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# =========================
#  Vision (description d'images, optionnel — désactivé par défaut)
# =========================
# VISION_ENABLED=false
# VISION_MODEL=gemini-2.5-flash-lite

# =========================
#  GLPI (optionnel) : rapatriement des captures document.send.php à l'ingestion
#  → les images GLPI deviennent des images internes, affichées inline.
#  App-Token : Configuration > Générale > API > Clients API
#  User token : Préférences utilisateur > Jetons d'API (API token)
# =========================
# GLPI_BASE_URL=https://glpi.example.com
# GLPI_APP_TOKEN=
# GLPI_USER_TOKEN=
# GLPI_VERIFY_SSL=true            # false si certificat interne auto-signé

# =========================
#  Divers
# =========================
# MAX_UPLOAD_MB=100
# DEBUG_TIMING=false
